# Terraform owns desired state. bootstrap-host.sh writes observed KLEE_RUNTIME separately.
BACKEND_IMAGE=${backend_image}
FRONTEND_IMAGE=${frontend_image}
RUNNER_IMAGE=${runner_image}

ADMIN_HTPASSWD_FILE=/etc/klee-web/admin.htpasswd
# Every provider TLS procedure writes to this shared host interface.
TLS_CERTIFICATE_FILE=/etc/klee-web/tls/fullchain.pem
TLS_PRIVATE_KEY_FILE=/etc/klee-web/tls/privkey.pem

# Replicas count Worker containers. Concurrency limits execution slots in each one.
WORKER_REPLICAS=${worker_replicas}
WORKER_CONCURRENCY_MAX=${worker_concurrency_max}
REDIS_MAXMEMORY=${redis_maxmemory}
RUNNER_CPUS=${runner_cpus}
RUNNER_MEMORY_MB=${runner_memory_mb}
RUNNER_SWAP_MB=${runner_swap_mb}
RUNNER_PIDS_LIMIT=${runner_pids_limit}
RUNNER_STORAGE_MB=${runner_storage_mb}
