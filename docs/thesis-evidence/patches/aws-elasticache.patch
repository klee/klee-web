diff --git a/deploy/set-admin-password.sh b/deploy/set-admin-password.sh
index f7661e3..0b52c83 100755
--- a/deploy/set-admin-password.sh
+++ b/deploy/set-admin-password.sh
@@ -3,6 +3,7 @@ set -euo pipefail
 
 readonly DEPLOYMENT_ENV=/etc/klee-web/deployment.env
 readonly ADMIN_HTPASSWD=/etc/klee-web/admin.htpasswd
+readonly MANAGED_REDIS_ENV=/etc/klee-web/managed-redis.env
 
 if ((EUID != 0)); then
   printf 'set-admin-password.sh must run as root\n' >&2
@@ -32,6 +33,41 @@ for certificate_file in "$TLS_CERTIFICATE_FILE" "$TLS_PRIVATE_KEY_FILE"; do
   fi
 done
 
+if [[ ${MANAGED_REDIS:-false} == true ]]; then
+  : "${REDIS_ENDPOINT:?REDIS_ENDPOINT must be set}"
+  : "${BACKEND_IMAGE:?BACKEND_IMAGE must be set}"
+
+  read -r -s -p 'Managed Redis AUTH token: ' redis_auth_token
+  printf '\n'
+  read -r -s -p 'Confirm managed Redis AUTH token: ' redis_auth_token_confirmation
+  printf '\n'
+  if [[ $redis_auth_token != "$redis_auth_token_confirmation" ]]; then
+    printf 'Managed Redis AUTH tokens do not match\n' >&2
+    exit 1
+  fi
+  if [[ ! $redis_auth_token =~ ^[[:alnum:]]{32,128}$ ]]; then
+    printf 'Managed Redis AUTH token must contain 32 to 128 letters or digits\n' >&2
+    exit 1
+  fi
+
+  umask 077
+  printf 'REDIS_URL=rediss://:%s@%s:6379/0\nCELERY_BROKER_URL=rediss://:%s@%s:6379/1?ssl_cert_reqs=required\n' \
+    "$redis_auth_token" "$REDIS_ENDPOINT" "$redis_auth_token" "$REDIS_ENDPOINT" \
+    > "$MANAGED_REDIS_ENV"
+  chmod 0600 "$MANAGED_REDIS_ENV"
+
+  # Use the application's Redis client to reject bad credentials before startup.
+  if ! docker run --rm --network host --env-file "$MANAGED_REDIS_ENV" \
+    "$BACKEND_IMAGE" python -c \
+    'import os; from kombu import Connection; from redis import Redis; Redis.from_url(os.environ["REDIS_URL"], socket_connect_timeout=5, socket_timeout=5).ping(); broker = Connection(os.environ["CELERY_BROKER_URL"]); broker.ensure_connection(max_retries=0); broker.close()' \
+    >/dev/null 2>&1; then
+    rm -f "$MANAGED_REDIS_ENV"
+    printf 'Managed Redis TLS/AUTH validation failed. KLEE Web was not started.\n' >&2
+    printf 'Rerun set-admin-password.sh and enter the Redis token again.\n' >&2
+    exit 1
+  fi
+fi
+
 # -c intentionally replaces the file. Omit it only if multiple usernames are supported.
 htpasswd -cB "$ADMIN_HTPASSWD" admin
 # The private parent protects the host file. nginx workers need read access after mounting.
