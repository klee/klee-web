diff --git a/deploy/compose.managed-redis.yml b/deploy/compose.managed-redis.yml
new file mode 100644
index 0000000..ab48379
--- /dev/null
+++ b/deploy/compose.managed-redis.yml
@@ -0,0 +1,25 @@
+services:
+  redis: !reset null
+
+  api:
+    depends_on: !reset null
+
+  worker:
+    depends_on: !reset null
+
+  nginx:
+    # Keep this override self-contained so only managed-service deployments receive it.
+    # Duplicating the TLS mounts avoids adding an inert cloud-init input to every provider.
+    volumes:
+      - type: bind
+        source: ${TLS_CERTIFICATE_FILE:?TLS_CERTIFICATE_FILE must be set}
+        target: /etc/nginx/certs/selfsigned.crt
+        read_only: true
+
+      - type: bind
+        source: ${TLS_PRIVATE_KEY_FILE:?TLS_PRIVATE_KEY_FILE must be set}
+        target: /etc/nginx/certs/selfsigned.key
+        read_only: true
+
+volumes:
+  redis-data: !reset null
